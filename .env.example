# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_js_starter?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed admin (used by prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Admin"

# Example external service reached through the server-side proxy.
# NOTE: no NEXT_PUBLIC_ prefix — this key must never reach the browser.
EXAMPLE_API_URL="http://127.0.0.1:8000"
EXAMPLE_API_KEY=""
