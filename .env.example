# Public site origin (no trailing slash). Used for sitemap, robots, and
# metadataBase / Open Graph absolute URLs. Safe to expose — not a secret.
# On Vercel, leave unset to fall back to the deployment URL.
NEXT_PUBLIC_SITE_URL="https://example.com"

# LLM provider for /api/chat — an OpenAI-compatible endpoint.
#
# Server-side only. Never prefix LLM_* with NEXT_PUBLIC_: that inlines the
# value into the browser bundle at build time, which publishes the key.
#
# Nothing here names a provider, so moving to a different one is a change to
# these three values and nothing else. See docs/spec.md § LLM Provider.
LLM_BASE_URL="https://example.invalid/v1"
LLM_API_KEY=""
LLM_MODEL=""
